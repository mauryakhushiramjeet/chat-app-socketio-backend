// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                  @id @default(autoincrement())
  name                      String
  email                     String               @unique
  password                  String
  image                     String?
  about                     String?
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  emailVerify               Boolean              @default(false)
  groupMember               GroupMembers[]
  groupMessage              GroupMessage[]
  messageSent               Messages[]           @relation("setMessage")
  messageReciev             Messages[]           @relation("recievMessage")
  currentUser               ChatConversation[]   @relation("currentUser")
  ChatUser                  ChatConversation[]   @relation("chatUser")
  userDeviceFcmToken        UserDeviceFcmToken[]
  LastActiveAt              DateTime?
  createdAt                 DateTime             @default(now())
}

model UserDeviceFcmToken {
  id        Int    @id @default(autoincrement())
  userId    Int
  user      User   @relation(fields: [userId], references: [id])
  fcm_Token String @unique
}

enum Status {
  Pending
  Send
  Delivered
  Read
}

model Messages {
  id                   Int      @id @default(autoincrement())
  text                 String?
  sender               User     @relation("setMessage", fields: [senderId], references: [id])
  receiver             User     @relation("recievMessage", fields: [receiverId], references: [id])
  senderId             Int
  receiverId           Int
  deletedByMeId        Int?
  replyToMessageId     Int?
  replyMessageSenderId Int?
  status               String   @default("Pending")
  deletedForAll        Boolean  @default(false)
  file                 File[]
  createdAt            DateTime @default(now())
}

model ChatConversation {
  id                   Int      @id @default(autoincrement())
  currentUserId        Int
  chatUserId           Int
  currentUser          User     @relation("currentUser", fields: [currentUserId], references: [id])
  chatUser             User     @relation("chatUser", fields: [chatUserId], references: [id])
  lastMessage          String
  reuestAccepted       Boolean  @default(false)
  lastMessageId        Int?
  lastMessageCreatedAt DateTime @default(now())
}

model Group {
  id           Int            @id @default(autoincrement())
  name         String
  image        String?
  groupMembers GroupMembers[]
  messages     GroupMessage[]

  createdAt DateTime @default(now())
}

model GroupMembers {
  id                Int      @id @default(autoincrement())
  userId            Int
  groupId           Int
  // lastMessageSeenId Int?
  lastSeenMessageId Int?
  admin             Boolean? @default(false)
  user              User     @relation(references: [id], fields: [userId])
  group             Group    @relation(references: [id], fields: [groupId])

  @@unique([userId, groupId])
}

model GroupMessage {
  id                   Int      @id @default(autoincrement())
  text                 String?
  groupId              Int
  userId               Int
  deletedByMeId        Int?
  deletedForAll        Boolean  @default(false)
  replyToMessageId     Int?
  replyMessageSenderId Int?
  file                 File[]
  sender               User     @relation(fields: [userId], references: [id])
  group                Group    @relation(fields: [groupId], references: [id])
  createdAt            DateTime @default(now())
}

model File {
  id             Int           @id @default(autoincrement())
  fileName       String
  fileType       String
  filePath       String
  messageId      Int?
  groupMessageId Int?
  isDeleted      Boolean       @default(false)
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id])
  message        Messages?     @relation(fields: [messageId], references: [id])
  createdAt      DateTime      @default(now())
}

// added new colom in group message and message which replymessagesenderId 
model ChatClear {
  id                Int      @unique @default(autoincrement())
  userId            Int
  chatPartnerUserId Int?
  groupId           Int?
  deletedAt         DateTime @default(now())

  @@unique([userId, chatPartnerUserId])
  @@unique([userId, groupId])
}
